{
  "name": "z80-function-tester",
  "version": "1.0.0",
  "description": "Load Z80 assembly, assemble it, run it, and inspect CPU + memory state. CLI and web GUI.",
  "type": "module",
  "bin": {
    "z80test": "src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "web": "tsx src/server.ts",
    "example": "tsx src/cli.ts examples/multiply.asm --reg b=6 --reg c=7 --dump 0x9000:8"
  },
  "keywords": ["z80", "assembly", "emulator", "assembler", "testing"],
  "license": "MIT",
  "dependencies": {
    "z80-asm": "^2.3.0",
    "z80-base": "^2.0.1",
    "z80-emulator": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
